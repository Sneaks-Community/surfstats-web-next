# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=surfstats
MYSQL_PASSWORD=surfstats_password
MYSQL_DATABASE=cksurf

# Player Analytics Database Configuration (optional - for player time tracking). Review documentation for required fork.
ANALYTICS_MYSQL_HOST=localhost
ANALYTICS_MYSQL_PORT=3306
ANALYTICS_MYSQL_USER=surfstats
ANALYTICS_MYSQL_PASSWORD=surfstats_password
ANALYTICS_MYSQL_DATABASE=player_analytics_surf

# Valkey Cache Configuration
VALKEY_URL=redis://localhost:6379

# Optional: Valkey Authentication
# VALKEY_USERNAME=valkey_user
# VALKEY_PASSWORD=your_secure_password

# Optional: Valkey TLS Configuration
# VALKEY_TLS=true
# VALKEY_TLS_REJECT_UNAUTHORIZED=false  # Set to 'true' with valid certificates

# Optional: Valkey Connection Timeout (milliseconds, default: 5000)
# VALKEY_CONNECT_TIMEOUT=5000

# Steam API Configuration
# Get your key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Server Configuration (JSON Array)
SERVERS_JSON=[{"name":"Main Server","ip":"127.0.0.1","port":27015}]

# Optional: Map Images Base URL
MAP_IMAGES_URL=https://image.gametracker.com/images/maps/160x120/csgo/

# Optional: Highest tier shown on the player Tier Distribution radar (default: 10)
# The chart uses the real maximum tier in your DB, capped at this value, so
# placeholder maps with junk tiers (e.g. a tier-69 stub) don't blow up the axes.
# MAX_TIER=10

# Optional: Site Configuration
NEXT_PUBLIC_SITE_TITLE=SurfStats - CS:GO Surf Community
NEXT_PUBLIC_SITE_NAME=SurfStats
NEXT_PUBLIC_SITE_DESCRIPTION=Statistics, leaderboards, and server information for our CS:GO surf community.
# Canonical public base URL used for robots.txt / sitemap.xml absolute links.
# If unset, these fall back to the incoming request host.
NEXT_PUBLIC_SITE_URL=https://stats.example.com

# Optional: Main Site Configuration
NEXT_PUBLIC_MAIN_SITE_URL=https://github.com/Sneaks-Community
NEXT_PUBLIC_MAIN_SITE_NAME=Main Site

# Optional: Footer Links Configuration
NEXT_PUBLIC_FOOTER_LINK_URL=https://discord.com/invite/your_invite_code
NEXT_PUBLIC_FOOTER_LINK_TEXT=Discord

# Optional: Map Download URL Configuration
# Prefix for map download URLs (e.g., https://example.com/maps/)
# Leave blank for no Download icon
NEXT_PUBLIC_MAP_DOWNLOAD_URL_PREFIX=
# Suffix for map download URLs (e.g., .bsp.bz2)
NEXT_PUBLIC_MAP_DOWNLOAD_URL_SUFFIX=

# Optional: API Rate Limiting (per-IP, backed by Valkey, applied to /api/* via middleware)
# Bounds cache-miss-cycling attacks against the DB pool. Fails open if Valkey is down.
# RATE_LIMIT_MAX=120            # Max requests per window per IP (default: 120)
# RATE_LIMIT_WINDOW_SECONDS=60  # Window length in seconds (default: 60)

# Optional: Max concurrent expensive DB queries (record/search scans), so a burst
# can't exhaust the connection pool and starve page rendering (default: 6).
# DB_MAX_CONCURRENT_EXPENSIVE=6

# Optional: Background warmer that keeps the most-browsed default players-list
# pages cache-hot, so they never trigger the full-table ranking query on a miss.
# PLAYERS_LIST_WARM_PAGES=10              # Number of leading pages to keep warm (default: 10)
# PLAYERS_LIST_WARM_INTERVAL_MS=300000    # How often to refresh them, in ms (default: 300000 = 5 min)

# Optional: Restrict the API (/api/*) to the site itself. The site's own origin
# is always allowed; set this to also allow other front-ends (comma-separated).
# ALLOWED_ORIGINS=https://stats.example.com,https://example.com

# Optional: Logging Configuration
LOG_LEVEL=warn

# Optional: Theme Configuration
# List of colors available: https://tailwindcss.com/docs/colors
# Primary accent color (default: emerald)
# Options: emerald, green, teal, cyan, sky, blue, indigo, violet, purple, fuchsia, pink, rose, red, orange, amber, yellow, lime
THEME_PRIMARY=emerald

# Secondary accent color (default: cyan)
THEME_SECONDARY=cyan

# Dark mode background color family (default: zinc)
# Options: slate, gray, zinc, neutral, stone
THEME_DARK_BACKGROUND=zinc

# Dark mode surface color family (default: zinc)
THEME_DARK_SURFACE=zinc

# Light mode background color family (default: gray)
THEME_LIGHT_BACKGROUND=gray

# Light mode surface color family (default: gray)
THEME_LIGHT_SURFACE=gray
