# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=surfstats
MYSQL_PASSWORD=surfstats_password
MYSQL_DATABASE=cksurf

# Player Analytics DB (optional, player time tracking; requires the fork, see docs). Enabled only
# when ANALYTICS_MYSQL_HOST or ANALYTICS_MYSQL_DATABASE is set: comment both out for no connection
# attempts. The other ANALYTICS_MYSQL_* values fall back to their MYSQL_* counterparts.
ANALYTICS_MYSQL_HOST=localhost
ANALYTICS_MYSQL_PORT=3306
ANALYTICS_MYSQL_USER=surfstats
ANALYTICS_MYSQL_PASSWORD=surfstats_password
ANALYTICS_MYSQL_DATABASE=player_analytics_surf
# ANALYTICS_HEALTHCHECK_INTERVAL_MS=60000  # DB re-check interval in ms (default: 60000; min 10000; 0 disables)

# Valkey Cache Configuration
VALKEY_URL=redis://localhost:6379

# Optional: Valkey Authentication
# VALKEY_USERNAME=valkey_user
# VALKEY_PASSWORD=your_secure_password

# Optional: Valkey TLS Configuration
# VALKEY_TLS=true
# VALKEY_TLS_REJECT_UNAUTHORIZED=false  # Default true; false only for self-signed certificates

# Optional: Valkey Connection Timeout (milliseconds, default: 5000)
# VALKEY_CONNECT_TIMEOUT=5000

# Steam API Configuration
# Get your key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Server Configuration (JSON Array)
SERVERS_JSON=[{"name":"Main Server","ip":"127.0.0.1","port":27015}]

# Optional: Map Images Base URL
MAP_IMAGES_URL=https://image.gametracker.com/images/maps/160x120/csgo/

# IANA timezone for rendered dates and the heatmap's day/hour buckets (default: UTC); boot fails if
# it's unknown. E.g. UTC, America/New_York, Europe/Berlin
DISPLAY_TZ=UTC

# Optional: Highest tier on the player Tier Distribution radar (default: 10). The chart uses your
# DB's real max tier, capped here, so junk-tier stubs (e.g. tier 69) don't blow up the axes.
# MAX_TIER=10

# Site Configuration (NEXT_PUBLIC_SITE_URL is required, the rest are optional)
NEXT_PUBLIC_SITE_TITLE=SurfStats - CS:GO Surf Community
NEXT_PUBLIC_SITE_NAME=SurfStats
NEXT_PUBLIC_SITE_DESCRIPTION=Statistics, leaderboards, and server information for our CS:GO surf community.
# REQUIRED: canonical public base URL (boot fails without it), for the API origin guard and absolute
# robots.txt / sitemap.xml / OpenGraph links. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=https://stats.example.com

# Optional: Main Site Configuration
NEXT_PUBLIC_MAIN_SITE_URL=https://github.com/Sneaks-Community
NEXT_PUBLIC_MAIN_SITE_NAME=Main Site

# Optional: Footer Links Configuration
NEXT_PUBLIC_FOOTER_LINK_URL=https://discord.com/invite/your_invite_code
NEXT_PUBLIC_FOOTER_LINK_TEXT=Discord

# Optional: Map download URL = prefix + map name + suffix (e.g. https://example.com/maps/ and
# .bsp.bz2). The Download icon shows only when both are set.
NEXT_PUBLIC_MAP_DOWNLOAD_URL_PREFIX=
NEXT_PUBLIC_MAP_DOWNLOAD_URL_SUFFIX=

# Optional: per-IP rate limits in Valkey for /api/* and pages (via proxy.ts), bounding cache-miss
# cycling against the DB pool. API, page and RSC requests have separate budgets; if Valkey is down,
# each instance counts in memory.
# RATE_LIMIT_MAX=120            # Max /api/* requests per window per IP (default: 120)
# RATE_LIMIT_PAGE_MAX=300       # Max page requests per window per IP (default: 300)
# RATE_LIMIT_PREFETCH_MAX=900   # Max router RSC requests (client navigations) per window per IP (default: 900)
# RATE_LIMIT_WINDOW_SECONDS=60  # Window length in seconds (default: 60)
# RATE_LIMIT_BLOCK_SECONDS=0    # Block an over-budget IP this long from the overrun, replacing
#                               # that window's reset (default: 0, disabled)

# Client-IP header for rate-limit keys: one your reverse proxy always overwrites (clients can send
# any header). If a CDN is the trust boundary, use its header (cf-connecting-ip, true-client-ip) or
# every visitor shares one bucket. Falls back to x-real-ip; a missing header is logged once.
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Optional: Max concurrent expensive DB queries (record/search scans), so a burst can't exhaust the
# pool and starve page rendering (default: 6).
# DB_MAX_CONCURRENT_EXPENSIVE=6

# Optional: Callers that may queue for one of those slots; past this they get a 503 instead of
# waiting behind multi-second scans (default: twice DB_MAX_CONCURRENT_EXPENSIVE).
# DB_MAX_QUEUED_EXPENSIVE=12

# Optional: MySQL connection pool tuning.
# DB_CONNECTION_LIMIT=20      # Max simultaneous connections in the pool (default: 20)
# DB_QUEUE_LIMIT=100          # Max queued connection requests; 0 = unlimited (default: 100)
# DB_CONNECT_TIMEOUT_MS=5000  # Initial connection timeout in ms (default: 5000)
# DB_STATEMENT_TIMEOUT_MS=8000   # Server-side cap per statement: kills a query the client gave up
#                                # on and frees its connection; also bounds the expensive-query
#                                # queue (waiters sit behind at most two). 0 disables (default: 8000)

# Optional: Background warmer that keeps the most-browsed default players-list
# pages cache-hot, so they never trigger the full-table ranking query on a miss.
# PLAYERS_LIST_WARM_PAGES=10              # Number of leading pages to keep warm (default: 10)
# PLAYERS_LIST_WARM_INTERVAL_MS=300000    # How often to refresh them, in ms (default: 300000 = 5 min)

# Optional: Restrict the API (/api/*) to the site itself. The site's own origin
# is always allowed; set this to also allow other front-ends (comma-separated).
# ALLOWED_ORIGINS=https://stats.example.com,https://example.com

# Optional: Logging Configuration
LOG_LEVEL=info

# Optional: Theme Configuration (color families: https://tailwindcss.com/docs/colors)
# Primary accent color (default: emerald)
# Options: emerald, green, teal, cyan, sky, blue, indigo, violet, purple, fuchsia, pink, rose, red, orange, amber, yellow, lime
THEME_PRIMARY=emerald

# Secondary accent color (default: cyan)
THEME_SECONDARY=cyan

# Dark mode background color family (default: zinc). Options: slate, gray, zinc, neutral, stone
THEME_DARK_BACKGROUND=zinc

# Light mode background color family (default: gray)
THEME_LIGHT_BACKGROUND=gray
