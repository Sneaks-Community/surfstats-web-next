services:

  surfstats-web-next:
    build:
      context: .
      dockerfile: Dockerfile
    image: surfstats-web-next:main
    container_name: surfstats-web-next
    restart: unless-stopped
    # Security
    security_opt:
      - "apparmor=docker-default"
      - "no-new-privileges=true"
    # Drop all container capabilities
    cap_drop:
      - ALL
    ports:
      - "3000:3000"
    env_file:
    - .env
    environment:
      - NODE_ENV=production
    depends_on:
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '1'
    
  valkey:
    image: valkey/valkey:9-alpine
    container_name: surfstats-valkey
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - valkey_data:/data
    command: valkey-server --appendonly yes
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    security_opt:
      - "apparmor=docker-default"
      - "no-new-privileges=true"
    cap_drop:
      - ALL
    cap_add:
      - CAP_CHOWN
      - CAP_SETUID
      - CAP_SETGID

volumes:
  valkey_data: