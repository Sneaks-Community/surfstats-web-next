services:

  surfstats-web-next:
    image: ghcr.io/sneaks-community/surfstats-web-next:dev
    container_name: surfstats-web-next
    restart: unless-stopped
    security_opt:
      - "apparmor=docker-default"
      - "no-new-privileges=true"
    cap_drop:
      - ALL
    ports:
      - "3000:3000"
    env_file:
    - .env
    environment:
      - NODE_ENV=production
    depends_on:
      valkey:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '1'

  valkey:
    image: valkey/valkey:9-alpine
    container_name: surfstats-valkey
    restart: unless-stopped
    volumes:
      - valkey_data:/data
    command: >
      valkey-server
      --appendonly yes
      --requirepass "${VALKEY_PASSWORD:?set VALKEY_PASSWORD in .env}"
      --maxmemory 256mb
      --maxmemory-policy allkeys-lru
    environment:
      # Read by valkey-cli, so the healthcheck authenticates without the password
      # reaching the process list.
      - REDISCLI_AUTH=${VALKEY_PASSWORD}
    # Match the reply: valkey-cli exits 0 even when it answers NOAUTH.
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep -q PONG"]
      interval: 5s
      timeout: 3s
      retries: 5
    user: valkey
    security_opt:
      - "apparmor=docker-default"
      - "no-new-privileges=true"
    cap_drop:
      - ALL

volumes:
  valkey_data: